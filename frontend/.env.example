# Copy to `.env` (or set in the Vercel project settings) and fill in the
# deployed service URLs. These are baked into the build at build time.

# Base URL of the deployed Spring Boot backend (no trailing slash).
VITE_API_BASE_URL=https://event-ticket-backend.onrender.com

# Public Keycloak realm endpoint — must match KEYCLOAK_ISSUER_URI on the backend.
VITE_KEYCLOAK_AUTHORITY=https://event-ticket-keycloak.onrender.com/realms/event-ticket-platform

VITE_KEYCLOAK_CLIENT_ID=event-ticket-platform-app
