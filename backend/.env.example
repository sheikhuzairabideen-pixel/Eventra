# ==============================================================
# Eventra Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' with real secrets to version control.
# ==============================================================

# Stripe API Keys (Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Database Configuration (Defaults match docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345678

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/event-ticket-platform
